# Актуальные формулы рабочей МТС.
# Комментарии начинаются с #. Непустые строки без # являются формулами МТС.
# □ — шаблонный слот / кандидат шаблонного поиска.
# ⟦s⟧N — смысл знака s в нотации N (Q — четверичная нотация ачисел, F — формальная нотация МТС).
# Фигурные скобки {} зарезервированы за пучковой нотацией и здесь как шаблон не используются.

∞ : □ = □ ⟼ □
∞ = ∞ ⟼ ∞

(□) = □

□□ : (□) ⟼ □
□(□) : □ ⟼ (□)
□□ : □ ⟼ □
□□ = □ ⟼ □

□□□ : (□□) ⟼ □
□□□ = ((□) ⟼ □) ⟼ □
□□□ = □ ⟼ □ ⟼ □

□(□□) : □ ⟼ (□□)
□□□ != □(□□)
□□□ != □ ⟼ (□ ⟼ □)

♂□ : ♂□ = ♂□ ⟼ □
♂∞ = ♂∞ ⟼ ∞

□♀ : □♀ = □ ⟼ □♀
∞♀ = ∞ ⟼ ∞♀

⟦[⟧Q : ∞♀
⟦]⟧Q : ♂∞

⟦[⟧Q⟦]⟧Q = ⟦[⟧Q ⟼ ⟦]⟧Q
⟦⟼⟧F : ⟦[⟧Q⟦]⟧Q
⟦⟼⟧F = ⟦[⟧Q ⟼ ⟦]⟧Q
