# Корневая система актуальной МТС.
# Формулы решаются одновременно.
# Каждая непустая строка без # является формулой формальной нотации МТС.
#
# Первичные скобочные нотации:
# (...) — круглая формальная нотация.
# [...] — квадратная ачисловая нотация.
# {...} — пучковая нотация.

# Бесконечная форма связи и её самозамыкание.
∞ : [] = [] ⟼ []
[] = ∞
∞ = ∞ ⟼ ∞

# Минимальная формальная форма смысла.
() : ♀() ⟼ ()♂

# Квадратные абиты полюсов формы как литералы внутри круглой формы.
([) : (♀∞)
(]) : (∞♂)

# Смысл связи и смысл несвязи.
(⟼) : (♀∞ ⟼ ∞♂)
(↛) : (∞♂ ⟼ ♀∞)

# Квадратные абитовые формы.
[1] : (⟼)
[0] : (↛)

# Начало и конец формы связи в актуальной ориентации (♀F — начало, F♂ — конец).
♀[] : ♀[] = ♀[] ⟼ []
[]♂ : []♂ = [] ⟼ []♂

# Равенство как совпадение форм самозамыкания и его отрицание.
(=) : {♀[] = ♀[], []♂ = []♂}
(!=) : ¬(=)

# Слой последовательностей связей.
([]) = []
([][]) = [][]
([] ⟼ []) = [] ⟼ []

[][] : [] ⟼ []
[][] = [] ⟼ []

[][][] : ([][]) ⟼ []
[][][] = ([] ⟼ []) ⟼ []
[][][] = [] ⟼ [] ⟼ []

[]([][]) : [] ⟼ ([][])
[][][] != []([][])
[][][] != [] ⟼ ([] ⟼ [])

# Пучковый слой и различимость пустого пучка от пустой формы связи.
{} != []
{[]} != []
{[], []} = {[]}
{[], [][]} = {[][], []}
[]{} = {}
{}[] = {}

# Расширение пучка по связям (описательное раскрытие, не мутация).
[]{[], [][]} = {[] ⟼ [], [] ⟼ [][]}
{[], [][]}[] = {[] ⟼ [], [][] ⟼ []}
{[], [][]}{[], [][]} = {[] ⟼ [], [] ⟼ [][], [][] ⟼ [], [][] ⟼ [][]}
