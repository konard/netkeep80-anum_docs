# Корневая система аксиом МТС.
# Формулы решаются одновременно.
# Каждая непустая строка без # является формулой формальной нотации МТС.
#
# Первичные скобочные нотации:
# (...) — явная формальная форма / группировка формы.
# [...] — нотация ачисла; форма одной связи.
# {...} — пучковая нотация; пучок / асеть связей.

∞ : [] = [] ⟼ []
[] = ∞
∞ = ∞ ⟼ ∞

([]) = []
([][]) = [][]
([] ⟼ []) = [] ⟼ []

[][] : [] ⟼ []
[][] = [] ⟼ []

[][][] : ([][]) ⟼ []
[][][] = ([] ⟼ []) ⟼ []
[][][] = [] ⟼ [] ⟼ []

[]([][]) : [] ⟼ ([][])
[][][] != []([][])
[][][] != [] ⟼ ([] ⟼ [])

♂[] : ♂[] = ♂[] ⟼ []
♂∞ = ♂∞ ⟼ ∞

[]♀ : []♀ = [] ⟼ []♀
∞♀ = ∞ ⟼ ∞♀

{} != []
{[]} != []
{[], []} = {[]}
{[], [][]} = {[][], []}

[]{[], [][]} = {[] ⟼ [], [] ⟼ [][]}
{[], [][]}[] = {[] ⟼ [], [][] ⟼ []}
{[], [][]}{[], [][]} = {[] ⟼ [], [] ⟼ [][], [][] ⟼ [], [][] ⟼ [][]}
