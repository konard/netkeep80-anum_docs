# Корневая система актуальной МТС.
# Формулы решаются одновременно.
# Каждая непустая строка без # является формулой формальной нотации МТС.
#
# Первичные скобочные нотации:
# (...) — круглая формальная нотация.
# [...] — квадратная ачисловая нотация.
# {...} — пучковая нотация.

∞ : [] = [] ⟼ []
[] = ∞
∞ = ∞ ⟼ ∞

() : ♀() ⟼ ()♂

([) : (♀∞)
(]) : (∞♂)

(⟼) : (♀∞ ⟼ ∞♂)
(↛) : (∞♂ ⟼ ♀∞)

[1] : (⟼)
[0] : (↛)

(=) : {[]♀ = []♀, ♂[] = ♂[]}
